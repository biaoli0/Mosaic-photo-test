{
	"name": "mosaic-backend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"build": "tsc -p tsconfig.build.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/index.js",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"express": "^5.0.1",
		"sharp": "^0.34.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/node": "^22",
		"supertest": "^7.0.0",
		"@types/supertest": "^6.0.2",
		"esbuild": "^0.28.0",
		"tsx": "^4.19.2",
		"typescript": "^6.0.2",
		"vitest": "^4.1.6"
	}
}
