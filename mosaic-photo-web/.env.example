VITE_MOSAIC_PHOTO_API_URL=http://localhost:3001

# Server-only (`$env/dynamic/private` in +page.server.ts). Tunes client chunk upload batching.
MOSAIC_CHUNK_TARGET_HEIGHT=1024
MOSAIC_CHUNK_CONCURRENCY=4

# Tile size slider on the home page (stay within API MIN_TILE_SIZE / MAX_TILE_SIZE when calling backend).
MOSAIC_TILE_SLIDER_MIN=2
MOSAIC_TILE_SLIDER_MAX=64